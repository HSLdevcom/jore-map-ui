    "url-loader": "^4",
    "validatorjs": "3.19.2",
    "webpack-dev-server": "^4",
    "webpack-manifest-plugin": "^5",
    "whatwg-fetch": "2.0.3"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "build": "node scripts/build.js",
    "test": "node scripts/test.js --env=jsdom",
    "test:ci": "CI=true node scripts/test.js",
    "test-coverage": "node scripts/test.js --env=jsdom --coverage",
    "lint": "tslint --project tsconfig.json --format codeFrame",
    "lint-fix": "tslint --fix --project tsconfig.json --format codeFrame 'src/**/*.ts'",
    "production": "serve -s -l 5000 build",
    "cypress": "CYPRESS_E2E=true cypress",
    "cypress:run:dev": "CYPRESS_E2E=true cypress run --env configFile=dev",
    "cypress:run:stage": "CYPRESS_E2E=true cypress run --env configFile=stage",
    "prettify-all-files": "npx prettier --write '**/*.ts'"
  },
  "devDependencies": {
    "@types/chroma-js": "^1.3.5",
    "@types/classnames": "^2.2.6",
    "@types/graphql": "14.5.0",
    "@types/history": "^4.7.0",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.2.7",
    "@types/leaflet-polylinedecorator": "^1.1.3",
    "@types/lodash": "^4.14.118",
    "@types/node": "^10.5.1",
    "@types/proj4": "^2.3.4",
    "@types/prop-types": "^15.5.3",
    "@types/qs": "^6.5.1",
    "@types/query-string": "^6.1.0",
    "@types/react": "16.14.21",
    "@types/react-datepicker": "^2.9.5",
    "@types/react-dom": "16.9.14",
    "@types/react-leaflet": "^1.1.6",
    "@types/react-router-dom": "5.1.5",
    "@types/react-select": "^3.0.0",
    "@types/validatorjs": "3.15.0",
    "cypress": "^15.11.0",
    "cypress-commands": "^0.3.1",
    "cypress-wait-until": "^1.6.1",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.10.0",
    "mobx-react-devtools": "^6.0.1",
    "postcss": "^8",
    "react-dev-utils": "^5.0.1",
    "sass": "^1.26.1",
    "sass-loader": "^13",
    "terser-webpack-plugin": "^5",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tslint": "^5.11.0",
    "tslint-config-airbnb": "^5.9.2",
    "tslint-config-prettier": "^1.18.0",
    "tslint-eslint-rules": "^5.3.1",
    "tslint-origin-ordered-imports-rule": "^1.1.2",
    "typescript": "4.9.5",
    "webpack": "^5",
    "webpack-cli": "^5"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}"
    ],
    "coveragePathIgnorePatterns": [
      ".*\\.d\\.ts",
      "<rootDir>/node_modules/"
    ],
    "setupFiles": [
      "<rootDir>/config/polyfills.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.(j|t)s?(x)",
      "<rootDir>/src/**/?(*.)(spec|test).(j|t)s?(x)"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "transform": {
      "^.+\\.(js|jsx|mjs)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.tsx?$": "<rootDir>/config/jest/typescriptTransform.js",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|mjs|ts|tsx)$"
    ],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "~/(.*)": "<rootDir>/src/$1"
    },
    "moduleFileExtensions": [
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "web.js",
      "js",
      "web.jsx",
      "jsx",
      "json",
      "node",
      "mjs"
    ],
    "globals": {
      "ts-jest": {
        "tsConfig": "tsconfig.test.json"
      }
    }
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": true
  },
  "resolutions": {
    "@types/react": "16.14.21",
    "@types/react-dom": "16.9.14",
    "cross-spawn": "^7.0.6",
    "minimatch": "^3.1.4",
    "sockjs-client": "^1.6.1",
    "eventsource": "^2.0.2",
    "trim-newlines": "^3.0.1",
    "semver": "^7.7.4"
  }
}
